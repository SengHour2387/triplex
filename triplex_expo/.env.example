# Full API base URL, including the /api path. REQUIRED for release builds (the app refuses to
# start without it). Dev builds default to the local backend:
#   iOS simulator    -> http://localhost:3000/api/
#   Android emulator -> http://10.0.2.2:3000/api/
# On a physical device use your computer's LAN IP:
# EXPO_PUBLIC_API_URL=http://192.168.1.20:3000/api
